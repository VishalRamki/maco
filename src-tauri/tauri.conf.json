{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "maco",
  "version": "1.0.0",
  "identifier": "com.vishalramkissoon.maco",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Maco",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localtun.dev; connect-src 'self' http://127.0.0.1:1984 ws://127.0.0.1:1984 http://localhost:* ws://localhost:*; ..."
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["binaries/go2rtc"]
  }
}
